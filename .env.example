# Porta em que o servidor vai rodar
PORT=3000

# Segredo usado para assinar o cookie de sessao (troque por um valor aleatorio)
SESSION_SECRET=troque-este-valor-por-algo-aleatorio-e-longo

# Usuario do painel admin
ADMIN_USER=admin

# Defina a senha admin executando: npm run set-password
# (isso gera o hash abaixo automaticamente e nao deve ser editado a mao)
ADMIN_PASS_HASH=
