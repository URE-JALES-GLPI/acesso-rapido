# Exemplo de configuracao Nginx como proxy reverso para o Acesso Rapido.
# Troque "meudominio.com" pelo seu dominio real (ou pelo IP, se nao tiver dominio).
# Salve como /etc/nginx/sites-available/acesso-rapido e crie um link em sites-enabled.

server {
    listen 80;
    server_name meudominio.com;

    location / {
        proxy_pass http://127.0.0.1:3000;
        proxy_http_version 1.1;
        proxy_set_header Upgrade $http_upgrade;
        proxy_set_header Connection 'upgrade';
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_cache_bypass $http_upgrade;
        client_max_body_size 10M;
    }
}

# Depois de ativar, rode: sudo certbot --nginx -d meudominio.com
# para gerar HTTPS gratis com o Let's Encrypt.
